{
  "schema_version": "l1ght5p33d/v1",
  "id": "bandlab-import",
  "application": "bandlab",
  "description": "Illustrative complete workflow. Use l1ght5p33d demo bandlab to generate matching synthetic files and an isolated server; regenerate this file for your real reviewed manifest.",
  "configuration": {
    "bandlab": {
      "mode": "fixture",
      "url": "http://127.0.0.1:8765/studio",
      "read_roots": [
        "C:/Music/MIDI"
      ],
      "track_limit": 16
    }
  },
  "workflow": {
    "name": "BandLab MIDI import",
    "steps": [
      {
        "id": "01_open_studio",
        "intent": "open studio",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "open_studio",
          "url_template": "bandlab",
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "studio_ready",
              "value": {
                "literal": "True"
              }
            }
          ]
        }
      },
      {
        "id": "02_create_project",
        "intent": "create project",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "create_project",
          "url_template": "bandlab",
          "body_template": {
            "name": "L1ght5p33d Import"
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "project_name",
              "value": {
                "literal": "L1ght5p33d Import"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_count",
              "value": {
                "literal": "0"
              }
            }
          ]
        }
      },
      {
        "id": "03_set_tempo",
        "intent": "set tempo",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "set_tempo",
          "url_template": "bandlab",
          "body_template": {
            "bpm": 120.0
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "tempo",
              "value": {
                "literal": "120.0"
              }
            }
          ]
        }
      },
      {
        "id": "04_import_file",
        "intent": "import file",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "import_file",
          "url_template": "bandlab",
          "body_template": {
            "path": "C:/Music/MIDI/drums.mid",
            "sha256": "7d3e8f4791fbbcec89f592cfe8271172c19874479524deccf86ee7cb30904f37",
            "expected_tracks": 1
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_count",
              "value": {
                "literal": "1"
              }
            }
          ]
        }
      },
      {
        "id": "05_configure_track",
        "intent": "configure track",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "configure_track",
          "url_template": "bandlab",
          "body_template": {
            "index": 0,
            "name": "01 drums - drums",
            "instrument": "Standard Drum Kit",
            "offset_seconds": 0.0
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_0_name",
              "value": {
                "literal": "01 drums - drums"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_0_instrument",
              "value": {
                "literal": "Standard Drum Kit"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_0_offset_seconds",
              "value": {
                "literal": "0.0"
              }
            }
          ]
        }
      },
      {
        "id": "06_import_file",
        "intent": "import file",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "import_file",
          "url_template": "bandlab",
          "body_template": {
            "path": "C:/Music/MIDI/bass.mid",
            "sha256": "dfa7c6dbe92a76be2a712d9728b5c340da04c90729499fe4af24f863745d914f",
            "expected_tracks": 1
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_count",
              "value": {
                "literal": "2"
              }
            }
          ]
        }
      },
      {
        "id": "07_configure_track",
        "intent": "configure track",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "configure_track",
          "url_template": "bandlab",
          "body_template": {
            "index": 1,
            "name": "02 bass - bass",
            "instrument": "Finger Bass",
            "offset_seconds": 0.0
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_1_name",
              "value": {
                "literal": "02 bass - bass"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_1_instrument",
              "value": {
                "literal": "Finger Bass"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_1_offset_seconds",
              "value": {
                "literal": "0.0"
              }
            }
          ]
        }
      },
      {
        "id": "08_save",
        "intent": "save",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "method": "save",
          "url_template": "bandlab",
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "saved",
              "value": {
                "literal": "True"
              }
            },
            {
              "kind": "field_equals",
              "match": {
                "provider": {
                  "literal": "bandlab"
                }
              },
              "field": "track_count",
              "value": {
                "literal": "2"
              }
            }
          ]
        }
      }
    ],
    "schema_version": 2
  }
}
