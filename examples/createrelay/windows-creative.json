{
  "schema_version": "createrelay/v1",
  "id": "windows-creative",
  "description": "Reviewable Windows fixture workflow. Run createrelay demo windows to generate actual local paths and calibration.",
  "application": "windows",
  "configuration": {
    "executable": "C:\\CreateRelayFixture\\CreateRelayFixture.exe",
    "title_re": "CreateRelay Creative Fixture",
    "template_root": "C:\\CreateRelayFixture\\calibration",
    "observables": {
      "title_text": {
        "method": "uia",
        "auto_id": "titleEditor",
        "control_type": "Edit"
      },
      "status": {
        "method": "uia",
        "auto_id": "statusText"
      }
    }
  },
  "workflow": {
    "schema_version": 2,
    "name": "windows-creative",
    "steps": [
      {
        "id": "set-artwork-title",
        "intent": "set artwork title",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "url_template": "windows",
          "method": "fill",
          "body_template": {
            "selectors": [
              {
                "method": "uia",
                "auto_id": "titleEditor",
                "control_type": "Edit"
              }
            ],
            "text": "Synthetic artwork"
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": "windows"
              },
              "field": "title_text",
              "value": "Synthetic artwork"
            }
          ]
        }
      },
      {
        "id": "apply-artwork-title",
        "intent": "apply artwork title",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "url_template": "windows",
          "method": "click",
          "body_template": {
            "selectors": [
              {
                "method": "uia",
                "auto_id": "applyTitle",
                "control_type": "Button"
              }
            ]
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": "windows"
              },
              "field": "status",
              "value": "Applied: Synthetic artwork"
            }
          ]
        }
      },
      {
        "id": "stamp-using-local-template",
        "intent": "stamp using local template",
        "action": "wait",
        "api_binding": {
          "kind": "tool",
          "on_unavailable": "halt",
          "url_template": "windows",
          "method": "click",
          "body_template": {
            "selectors": [
              {
                "method": "uia",
                "auto_id": "missingStampButton",
                "control_type": "Button"
              },
              {
                "method": "template",
                "template": "stamp.png",
                "confidence": 0.98
              }
            ]
          },
          "effects": [
            {
              "kind": "field_equals",
              "match": {
                "provider": "windows"
              },
              "field": "status",
              "value": "Stamped"
            }
          ]
        }
      }
    ]
  }
}